generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingNumber  String
  customerName    String
  customerPhone   String?
  customerEmail   String?
  destination     String?
  status          String         @default("Pending") // Pending, In Transit, Pickup Ready, Returned, Delivered
  statusDetails   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  alerts          Alert[]

  @@unique([userId, trackingNumber])
}

model Alert {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String   // e.g. "Pickup Ready", "Return Initiated", "Delivery Confirmed", "Delayed Shipment"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Shopify Order Confirmation Flow ──────────────────────────────────────────
model ShopifyOrder {
  id                 String    @id @default(uuid())
  shopifyOrderId     String    @unique  // Shopify's own order ID
  orderNumber        String              // Human-readable: #1001
  customerName       String
  customerPhone      String              // The number we send WhatsApp to
  customerEmail      String?

  // Confirmation state machine:
  // PENDING    → WhatsApp sent, waiting for reply
  // CONFIRMED  → Customer replied YES
  // CANCELLED  → Customer replied NO
  // NO_RESPONSE → 48h passed, vendor notified to call
  confirmationStatus String    @default("PENDING")

  whatsappSentAt     DateTime?           // When we sent the first WhatsApp message
  reminderSentAt     DateTime?           // When we sent the 24h reminder
  vendorNotifiedAt   DateTime?           // When we emailed vendor (confirmed/cancelled/no-response)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
